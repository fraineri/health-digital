generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Patient {
  id              String         @id @default(uuid())
  name            String
  email           String         @unique
  phone           String?
  dateOfBirth     DateTime?
  gender          String?
  vulnerableGroup String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  appointments    Appointment[]
  consultations   Consultation[]
}

enum AppointmentType {
  FIRST_CONSULTATION
  FOLLOW_UP
}

model Appointment {
  id              String           @id @default(uuid())
  calBookingUid   String           @unique // External ID from Cal.com
  patientId       String
  patient         Patient          @relation(fields: [patientId], references: [id])
  status          BookingStatus    @default(PENDING)
  appointmentType AppointmentType  @default(FIRST_CONSULTATION)
  eventTypeSlug   String?
  startTime       DateTime
  endTime         DateTime
  timeZone        String
  meetingUrl      String?
  location        String?
  cancelledAt     DateTime?
  rescheduledFrom String?
  triageResponses TriageResponse[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  consultation    Consultation?
}

model TriageResponse {
  id             String      @id @default(uuid())
  appointmentId  String
  appointment    Appointment @relation(fields: [appointmentId], references: [id])
  reasonForVisit String?
  rawResponses   Json?
  createdAt      DateTime    @default(now())
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  RESCHEDULED
  DONE
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("DOCTOR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Consultation {
  id                 String       @id @default(uuid())
  patientId          String
  patient            Patient      @relation(fields: [patientId], references: [id])
  appointmentId      String?      @unique
  appointment        Appointment? @relation(fields: [appointmentId], references: [id])
  encryptedNotes     String?
  encryptedAnamnesis String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

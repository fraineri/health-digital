generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Patient {
  id                      String         @id @default(uuid())
  name                    String
  email                   String         @unique
  phone                   String?
  dateOfBirth             DateTime?
  gender                  String?
  vulnerableGroup         String?
  
  // — Perfil Médico y Administrativo —
  occupation              String?
  address                 String?
  bloodType               String?
  encryptedMedicalHistory String?
  encryptedAllergies      String?
  lifestyle               Json?
  
  // — Meta Data de Perfil —
  profileSource           String?        // Ej. "CAL_COM" o "PORTAL"
  lastProfileUpdate       DateTime?
  
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  
  // Relaciones
  appointments            Appointment[]
  consultations           Consultation[]
}

enum AppointmentType {
  FIRST_CONSULTATION
  FOLLOW_UP
}

model Appointment {
  id              String           @id @default(uuid())
  calBookingUid   String           @unique // External ID from Cal.com
  patientId       String
  patient         Patient          @relation(fields: [patientId], references: [id])
  status          BookingStatus    @default(PENDING)
  appointmentType AppointmentType  @default(FIRST_CONSULTATION)
  eventTypeSlug   String?
  startTime       DateTime
  endTime         DateTime
  timeZone        String
  meetingUrl      String?
  location        String?
  cancelledAt     DateTime?
  rescheduledFrom String?
  triageResponses TriageResponse[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  consultation    Consultation?
}

model TriageResponse {
  id             String      @id @default(uuid())
  appointmentId  String
  appointment    Appointment @relation(fields: [appointmentId], references: [id])
  reasonForVisit String?
  rawResponses   Json?
  createdAt      DateTime    @default(now())
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  RESCHEDULED
  DONE
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("DOCTOR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Consultation {
  id                 String       @id @default(uuid())
  patientId          String
  patient            Patient      @relation(fields: [patientId], references: [id])
  appointmentId      String?      @unique
  appointment        Appointment? @relation(fields: [appointmentId], references: [id])
  // — Dosha Scoring (Motor) —
  vataSuggested      Float?       // Valor sugerido por el motor (0-100)
  pittaSuggested     Float?
  kaphaSuggested     Float?
  vataFinal          Float?       // Valor final decidido por la médica
  pittaFinal         Float?
  kaphaFinal         Float?

  // — Treatment Plan (Selects) —
  nutritionPlan      String?      // Ej: "Dieta Anti-Vata (Pacificadora)"
  phytotherapy       String?      // Ej: "Triphala + Ashwagandha (PM)"
  dailyRoutine       String?      // Ej: "Rutina de Mañana Vata: Oleación"

  // — Clinical Notes (Encriptados) —
  encryptedNotes     String?
  encryptedAnamnesis String?
  encryptedDiagnosis String?

  // — Síntesis Clínica Integrativa —
  agniType           String?      // Enum lógico: "SAMA" | "VISHAMA" | "TIKSHNA" | "MANDA"
  amaLevel           Int?         // 0-3 (intensidad de toxinas)

  // — Symptom Scores (snapshot del checklist) —
  symptomSnapshot    Json?        // Snapshot de los síntomas marcados

  // — Metadata —
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}
